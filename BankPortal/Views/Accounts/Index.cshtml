@{
    ViewData["Title"] = "Bank Accounts";
}
<link rel="stylesheet" type="text/css" href="~/css/Index.css">
@section Scripts {
    <script src="~/js/accountnumbervalidation.js"></script>
}

<div class="container">
    <h1>Bank Accounts</h1>

    <!-- Display Success or Error Message -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">
            <strong>Success!</strong> @TempData["SuccessMessage"]
            <button type="button" class="close" data-dismiss="alert" aria-label="Close" onclick="closeAlert()">
                <span aria-hidden="true">&times;</span>
            </button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert" id="error-message">
            <strong>Error!</strong> @TempData["ErrorMessage"]
            <button type="button" class="close" data-dismiss="alert" aria-label="Close" onclick="closeAlert()">
                <span aria-hidden="true">&times;</span>
            </button>
        </div>
    }

    <!-- Search Form -->
    <form method="get" asp-action="Search" class="search-form">
        <label for="accountNumber">Enter Account Number:</label>
        <div class="search-input-container">
            <input type="text" id="accountNumber" name="accountNumber" required
                
                pattern="\d{10}" title="Account number must be 10 digits"
                   inputmode="numeric" maxlength="20"  />
            <button type="submit" class="btn-submit">
                <i class="fas fa-search"></i> Search
            </button>
        </div>
    </form>

    <hr />

    <!-- Link to Open New Account -->
    <a asp-action="Add" class="btn-open-account">Open New Account</a>
</div>
